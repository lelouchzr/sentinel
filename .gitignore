# Dependencies
/node_modules
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# A template contains names only, never real values.
!.env.example

# Previous Slim checkout and local migration/preview artifacts
/frame/
/experiments/
/artifacts/
/web/
/.venv/
/.slim/
/.pytest_cache/
/.ruff_cache/
/.coverage
/htmlcov/
/.npm/
__pycache__/
