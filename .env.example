# Copy to .env and export values in your shell; Slim does not auto-load secrets.
SLIM_MODEL_ENABLED=0
SLIM_MODEL_URL=http://127.0.0.1:11434/v1
SLIM_MODEL=llama3.2:3b
# Optional for a hosted endpoint. Never put a real token in this file.
SLIM_MODEL_KEY=
# Explicitly enable execution only for repositories you trust.
SLIM_ALLOW_EXECUTION=0
SLIM_RUNNER=local
# SLIM_WORKSPACE=/absolute/path/to/slim
# SLIM_DATA_DIR=/absolute/path/to/slim/.slim
