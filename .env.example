# Planned application configuration. No app consumes this file yet.
# Copy to .env.local only when application setup begins.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never add a NEXT_PUBLIC_ prefix to these.
SUPABASE_SECRET_KEY=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ko-KR-SunHiNeural

# Proposed defaults; implement and test enforcement before enabling paid calls.
AI_ENABLED=false
META_ALLOCATED_CREDITS_USD=150
META_DEVELOPMENT_LIMIT_USD=120
META_DEMO_RESERVE_USD=30
AI_MAX_CONCURRENT_OPERATIONS=2
MAX_SESSION_TURNS=8
MAX_SESSION_SECONDS=300
MAX_AUDIO_TURN_SECONDS=30
MAX_AUDIO_BYTES=2097152
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_ROWS=500
MAX_TEXT_IMPORT_BYTES=1048576
