# Export these in your shell. Sentinel does not load .env files automatically.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
SENTINEL_WORKSPACE=.sentinel
# META_API_KEY takes precedence over MODEL_API_KEY.
SENTINEL_MAX_MODEL_CALLS=10
SENTINEL_MAX_TOOL_CALLS=18
SENTINEL_REQUEST_TIMEOUT=45
SENTINEL_DEADLINE=180
