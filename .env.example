# Local application configuration. Copy to ignored .env.local when ready.
# Keep AI disabled until the database, prices and account access are verified.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never add a NEXT_PUBLIC_ prefix to these.
SUPABASE_SECRET_KEY=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ko-KR-SunHiNeural

# Runtime switches and budget limits.
AI_ENABLED=false
META_DEVELOPMENT_LIMIT_USD=120
AI_MAX_CONCURRENT_OPERATIONS=2
MAX_SESSION_TURNS=8
MAX_SESSION_SECONDS=300

# First real experiment: cumulative conservative Meta budget, at most $5 initially.
META_RUN_LIMIT_USD=5
# Azure has a separate ledger; unresolved/unknown costs retain a $1 reservation.
AZURE_RUN_LIMIT_USD=5

# Fixed protocol caps in code: audio 30s/2MiB, image 5MiB/20Mpx, text 1MiB/500 rows.
# Meta allocation is $150: the development ceiling preserves a $30 demo reserve.

# Private maintenance API bearer secret. Generate a random value of at least 32 characters.
MAINTENANCE_SECRET=
